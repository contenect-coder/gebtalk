# ==========================================
# GEBTALK Pure Internet WebRTC Audio Calling Configuration
# ==========================================

# Signaling Server Port & Host
PORT=8080
HOST=0.0.0.0

# Frontend WebSocket Server URL
VITE_WS_SERVER_URL=ws://localhost:8080

# NAT Traversal - Public STUN Servers (Comma-separated)
STUN_SERVER_URL=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478

# NAT Traversal - Optional Self-Hosted / Metered TURN Servers
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Call Timeouts (Milliseconds)
CALL_RING_TIMEOUT=30000
WEBRTC_CONNECTION_TIMEOUT=20000
SIGNALING_HEARTBEAT=15000
